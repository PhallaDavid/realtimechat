rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() && chatId.matches('.*' + request.auth.uid + '.*');
    }

    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasAll(['id', 'username', 'email', 'XyncId'])
                    && request.resource.data.id == userId
                    && request.resource.data.XyncId is string
                    && request.resource.data.username is string
                    && request.resource.data.email is string;

      allow update: if (
                      isOwner(userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'username',
                        'about',
                        'github_username',
                        'img_link',
                        'email',
                        'privacy',
                        'contacts',
                        'XyncId'
                      ])
                      && (!('id' in request.resource.data) || request.resource.data.id == userId)
                    )
                    || (
                      isAuthenticated()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacts'])
                      && request.resource.data.contacts.hasAll(resource.data.contacts)
                      && (
                        request.resource.data.contacts.size() == resource.data.contacts.size()
                        || request.resource.data.contacts.size() == resource.data.contacts.size() + 1
                      )
                    );

      allow delete: if isOwner(userId);
    }

    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isChatParticipant(chatId);

      allow create: if isChatParticipant(chatId)
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.createdAt != null;

      allow update, delete: if isChatParticipant(chatId)
                            && resource.data.senderId == request.auth.uid;
    }

    match /metadata/userCounter {
      allow read, write: if false;
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated() && resource.data.members.hasAny([request.auth.uid]);
      allow create: if isAuthenticated() && request.resource.data.members.hasAny([request.auth.uid]);
      allow update: if isAuthenticated() && resource.data.members.hasAny([request.auth.uid]);
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.uid]);
        allow create: if isAuthenticated()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.createdAt != null;
        allow update, delete: if isAuthenticated()
                              && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
