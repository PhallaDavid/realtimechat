rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chats/{chatId}/{fileName} {
      allow read: if request.auth != null
                  && chatId.matches('.*' + request.auth.uid + '.*');

      allow write: if request.auth != null
                   && chatId.matches('.*' + request.auth.uid + '.*')
                   && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
